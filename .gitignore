.DS_Store
.gitignore
node_modules
public
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
private/
.replit
replit.nix
.quartz/
quartz/cli/tui/dist/
.turbo/

# Заготовки проектов в resources/ раздаются студентам вместе со своим
# .gitignore (в нём одна строка «.pio»), а правило выше, пришедшее из
# upstream, прячет любой файл с таким именем на любой глубине. Без этого
# исключения .gitignore заготовки не попал бы ни в репозиторий, ни в архив
# работы — и каталог сборки PlatformIO лез бы студенту в git с первой сборки.
!resources/**/.gitignore
